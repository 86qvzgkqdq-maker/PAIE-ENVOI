# Configuration SMTP pour l'envoi des emails — copier ce fichier en `.env`
# et remplir les valeurs. Le fichier .env ne doit JAMAIS être partagé/commité.

# Exemples courants :
#  - OVH        : SMTP_HOST=ssl0.ovh.net          SMTP_PORT=465
#  - Gmail      : SMTP_HOST=smtp.gmail.com        SMTP_PORT=587  (mot de passe d'application requis)
#  - Office 365 : SMTP_HOST=smtp.office365.com    SMTP_PORT=587
#  - iCloud     : SMTP_HOST=smtp.mail.me.com      SMTP_PORT=587  (mot de passe d'application requis)

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Adresse d'expéditeur si différente de SMTP_USER (optionnel)
SMTP_FROM=
